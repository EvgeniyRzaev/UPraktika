<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EventApp.Views.EventsView"
             xmlns:v="using:EventApp.Views"
             xmlns:vm="using:EventApp.ViewModels"
             x:DataType="vm:EventsViewModel">

	<Border Background="#1E1E2E" Padding="20" CornerRadius="10">
		<StackPanel>
			<!-- Заголовок -->
			<Border Background="#282C34" Padding="10" Margin="0,0,0,10" BorderBrush="#61AFEF" BorderThickness="0,0,0,2">
				<TextBlock Text="Список мероприятий" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
			</Border>

			<!-- Список мероприятий -->
			<ListBox ItemsSource="{Binding Events}" Name="EventsList" Width="600" Height="500" Background="#282C34" BorderThickness="0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Background="#3C4048" Padding="10" CornerRadius="10" Margin="5">
							<StackPanel Orientation="Horizontal">
								<Border Width="100" Height="100" CornerRadius="8" BorderBrush="#61AFEF" BorderThickness="1">
									<Image Source="{Binding Image}" Width="100" Height="100" Stretch="UniformToFill"/>
								</Border>
								<StackPanel Margin="10" VerticalAlignment="Center">
									<TextBlock Text="{Binding EventTitle}" FontWeight="Bold" FontSize="16" Foreground="White"/>
									<TextBlock Text="{Binding StartDate, StringFormat=Дата начала: {0}}" Foreground="LightGray"/>
									<TextBlock Text="{Binding Days, StringFormat=Количество дней: {0}}" Foreground="LightGray"/>
								</StackPanel>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
	</Border>
</UserControl>
